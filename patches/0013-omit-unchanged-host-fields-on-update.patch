+// omitUnchangedHostUpdateFields drops unchanged attributes from the update
+// payload so Foreman keeps inherited hostgroup values (puppet classes, proxies,
+// environment) and does not rewrite interfaces or the build token.
+func omitUnchangedHostUpdateFields(d *schema.ResourceData, h *api.ForemanHost) {
+	if !d.HasChange("set_build_flag") {
+		h.Build = nil
+		h.Token = ""
+	}
+	if !d.HasChange("environment_id") {
+		h.EnvironmentId = nil
+	}
+	if !d.HasChange("puppet_proxy_id") {
+		h.PuppetProxyId = nil
+	}
+	if !d.HasChange("puppet_ca_proxy_id") {
+		h.PuppetCAProxyId = nil
+	}
+	if !d.HasChange("hdm_proxy_id") {
+		h.HdmProxyId = nil
+	}
+	if !d.HasChange("domain_id") {
+		h.DomainId = nil
+	}
+	if !d.HasChange("subnet_id") {
+		h.SubnetId = nil
+	}
+	if !d.HasChange("owner_id") {
+		h.OwnerId = nil
+	}
+	if !d.HasChange("architecture_id") {
+		h.ArchitectureId = nil
+	}
+	if !d.HasChange("ptable_id") {
+		h.PtableId = nil
+	}
+	if !d.HasChange("operatingsystem_id") {
+		h.OperatingSystemId = nil
+	}
+	if !d.HasChange("medium_id") {
+		h.MediumId = nil
+	}
+	if !d.HasChange("image_id") {
+		h.ImageId = nil
+	}
+	if !d.HasChange("model_id") {
+		h.ModelId = nil
+	}
+	if !d.HasChange("compute_resource_id") {
+		h.ComputeResourceId = nil
+	}
+	if !d.HasChange("compute_profile_id") {
+		h.ComputeProfileId = nil
+	}
+	if !d.HasChange("comment") {
+		h.Comment = ""
+	}
+	if !d.HasChange("owner_type") {
+		h.OwnerType = ""
+	}
+	if !d.HasChange("provision_method") {
+		h.ProvisionMethod = ""
+	}
+	if !d.HasChange("parameters") {
+		h.HostParameters = nil
+	}
+	if !d.HasChange("puppet_class_ids") && !d.HasChange("config_group_ids") {
+		h.PuppetClassIds = nil
+		h.ConfigGroupIds = nil
+		h.PuppetAttributes = nil
+	}
+	if !d.HasChange("interfaces_attributes") {
+		h.InterfacesAttributes = nil
+	}
