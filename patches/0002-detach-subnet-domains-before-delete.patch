diff --git a/foreman/resource_foreman_subnet.go b/foreman/resource_foreman_subnet.go
--- a/foreman/resource_foreman_subnet.go
+++ b/foreman/resource_foreman_subnet.go
@@ -380,5 +380,17 @@ func resourceForemanSubnetDelete(ctx context.Context, d *schema.ResourceData, me
 
 	log.Debugf("ForemanSubnet: [%+v]", s)
 
+	// Foreman does not allow deleting a subnet while it is associated with
+	// domains. Explicitly clear those associations before deleting the subnet.
+	s.DomainIDs = []int{}
+	if _, updateErr := client.UpdateSubnet(ctx, s); updateErr != nil {
+		if checkErr := api.CheckDeleted(d, updateErr); checkErr != nil {
+			return diag.FromErr(fmt.Errorf("failed to detach subnet from domains: %w", checkErr))
+		}
+		if d.Id() == "" {
+			return nil
+		}
+	}
+
 	return diag.FromErr(api.CheckDeleted(d, client.DeleteSubnet(ctx, s.Id)))
 }
